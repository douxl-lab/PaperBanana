{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paperbanana:rfs:figure-spec:1.0.0",
  "title": "PaperBanana FigureSpec exchange v1",
  "description": "Public mapping contract. External RFS consumer acceptance is not verified.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "figure_id", "kind", "nodes", "edges", "groups", "labels", "datasets", "sources", "constraints", "design", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "figure_id": {"$ref": "#/$defs/id"},
    "kind": {"enum": ["diagram", "plot", "hybrid"]},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "labels": {"type": "array", "items": {"$ref": "#/$defs/label"}},
    "datasets": {"type": "array", "items": {"$ref": "#/$defs/dataset"}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "constraints": {"$ref": "#/$defs/constraints"},
    "design": {"$ref": "#/$defs/design"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["origin", "scientific_verification", "external_consumer_verified"], "properties": {
      "origin": {"enum": ["user_supplied", "model_generated"]},
      "scientific_verification": {"enum": ["unverified", "user_verified"]},
      "external_consumer_verified": {"const": false},
      "notes": {"type": "array", "items": {"type": "string"}}
    }}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "text": {"type": "string", "minLength": 1},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "quote"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "quote": {"$ref": "#/$defs/text"}}}},
    "node": {"type": "object", "additionalProperties": false, "required": ["id", "label", "kind", "evidence"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "kind": {"$ref": "#/$defs/text"},
      "formula": {"$ref": "#/$defs/text"}, "dataset_ids": {"$ref": "#/$defs/ids"}, "evidence": {"$ref": "#/$defs/evidence"}
    }},
    "edge": {"type": "object", "additionalProperties": false, "required": ["id", "source", "target", "kind", "directed", "evidence"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/id"}, "target": {"$ref": "#/$defs/id"},
      "kind": {"$ref": "#/$defs/text"}, "directed": {"type": "boolean"}, "label": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/evidence"}
    }},
    "group": {"type": "object", "additionalProperties": false, "required": ["id", "label", "node_ids", "evidence"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"}, "node_ids": {"$ref": "#/$defs/ids"}, "evidence": {"$ref": "#/$defs/evidence"}}},
    "label": {"type": "object", "additionalProperties": false, "required": ["id", "text", "target_ids", "evidence"], "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/text"}, "target_ids": {"$ref": "#/$defs/ids"}, "evidence": {"$ref": "#/$defs/evidence"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "content", "sha256"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["user_text", "user_data", "paper_excerpt"]}, "content": {"$ref": "#/$defs/text"},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uri": {"type": "string", "pattern": "^https?://"},
      "locator": {"$ref": "#/$defs/text"}, "relative_path": {"$ref": "#/$defs/text"}
    }},
    "dataset": {"type": "object", "additionalProperties": false, "required": ["id", "name", "source_id", "columns", "rows", "sha256"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"}, "source_id": {"$ref": "#/$defs/id"},
      "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
      "units": {"type": "object", "additionalProperties": {"type": "string"}},
      "rows": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": ["string", "number", "boolean", "null"]}}},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "encoding": {"type": "object", "additionalProperties": false, "properties": {"x": {"$ref": "#/$defs/text"}, "y": {"$ref": "#/$defs/text"}, "color": {"$ref": "#/$defs/text"}, "chart_type": {"$ref": "#/$defs/text"}}}
    }},
    "constraints": {"type": "object", "additionalProperties": false, "required": ["locked", "required_labels", "layout", "visual", "negative"], "properties": {
      "locked": {"const": true}, "required_labels": {"$ref": "#/$defs/texts"}, "layout": {"$ref": "#/$defs/texts"}, "visual": {"$ref": "#/$defs/texts"}, "negative": {"$ref": "#/$defs/texts"}
    }},
    "design": {"type": "object", "additionalProperties": false, "required": ["layout", "composition", "palette", "typography", "candidate_variation"], "properties": {
      "layout": {"$ref": "#/$defs/text"}, "composition": {"$ref": "#/$defs/text"}, "palette": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}, "typography": {"$ref": "#/$defs/text"}, "candidate_variation": {"type": "string"}
    }}
  }
}
